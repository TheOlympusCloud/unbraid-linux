// Inputs: the chevron that ends a row, the pill and dialog text fields, the confirm dialog, and a caption in the page's
// gutters.

import { Ink, Type, Small, Title, Sub, Caption } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { Metrics, IconTap, Secondary, Modal } from "components.slint";
import { Motion } from "motion.slint";

// The end of a row that opens something: its value, if any, then the chevron.
export component Chevron inherits HorizontalLayout {
    in property <string> value;
    spacing: 6px;
    cross-axis-alignment: center;
    horizontal-stretch: 0;
    if root.value != "": Small {
        text: root.value;
        color: Ink.dim;
    }
    Icon {
        icon: Icons.chevron;
        size: 16px;
        tint: Ink.faint;
    }
}

// Pill text field. Secret fields are monospace with a show/hide eye; the accent rings it while it has focus.
export component PillField inherits Rectangle {
    in-out property <string> value;
    // Its name for screen readers, and the placeholder unless one is given.
    in property <string> label;
    in property <string> placeholder: self.label;
    in property <bool> secret;
    callback changed(text: string);
    // Enter: the keyboard's Done.
    callback done();
    private property <bool> shown;
    height: 56px;
    border-radius: 28px;
    background: Ink.surface-high;
    border-width: 2px;
    border-color: input.has-focus ? Ink.accent : transparent;
    forward-focus: input;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: root.secret ? 4px : 20px;
        cross-axis-alignment: center;
        Rectangle {
            horizontal-stretch: 1;
            if root.value == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Ink.dim;
                font-family: root.secret ? Type.mono : Type.sans;
                font-size: root.secret ? 13px : 16px;
                font-weight: root.secret ? 400 : 500;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.value;
                color: Ink.text;
                font-family: root.secret ? Type.mono : Type.sans;
                font-size: root.secret ? 13px : 16px;
                font-weight: root.secret ? 400 : 500;
                input-type: root.secret && !root.shown ? InputType.password : InputType.text;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: Ink.accent-container;
                selection-foreground-color: Ink.text;
                accessible-label: root.label;
                edited => {
                    root.changed(self.text);
                }
                accepted => {
                    root.done();
                }
            }
        }
        if root.secret: IconTap {
            icon: root.shown ? Icons.eye-off : Icons.eye;
            label: (root.shown ? "Hide " : "Show ") + root.label;
            tint: Ink.dim;
            clicked => {
                root.shown = !root.shown;
            }
        }
    }
}

// Dialog text field: Material's outlined field, its label resting inside until the field has focus or text, then on
// the outline. Monospace, as keys and addresses are; secret fields are masked, with a show/hide eye.
export component DialogField inherits Rectangle {
    in-out property <string> value;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret;
    in property <bool> single-line: true;
    // The surface the field sits on: the floating label cuts the outline with it.
    in property <color> ground: Ink.surface;
    callback changed(text: string);
    private property <bool> shown;
    private property <bool> focused: input.has-focus;
    private property <bool> up: self.focused || self.value != "";
    min-height: 56px;
    forward-focus: input;
    Rectangle {
        border-radius: 4px;
        border-width: root.focused ? 2px : 1px;
        border-color: root.focused ? Ink.accent : Ink.line;
    }
    // The text keeps Material's 16 px above and below; the eye, 40 px, sits within that, so the field stays 56 px.
    HorizontalLayout {
        padding-left: 16px;
        padding-right: root.secret ? 4px : 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        cross-axis-alignment: center;
        Rectangle {
            horizontal-stretch: 1;
            min-height: input.preferred-height + 16px;
            if root.up && root.value == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Ink.faint;
                font-family: Type.mono;
                font-size: 13px;
                vertical-alignment: center;
                accessible-role: none;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.value;
                color: Ink.text;
                font-family: Type.mono;
                font-size: 13px;
                input-type: root.secret && !root.shown ? InputType.password : InputType.text;
                single-line: root.single-line;
                wrap: root.single-line ? TextWrap.no-wrap : TextWrap.word-wrap;
                vertical-alignment: center;
                selection-background-color: Ink.accent-container;
                selection-foreground-color: Ink.text;
                accessible-label: root.label;
                accessible-placeholder-text: root.placeholder;
                edited => {
                    root.changed(self.text);
                }
            }
        }
        if root.secret: IconTap {
            icon: root.shown ? Icons.eye-off : Icons.eye;
            label: (root.shown ? "Hide " : "Show ") + root.label;
            size: 40px;
            tint: Ink.dim;
            clicked => {
                root.shown = !root.shown;
            }
        }
    }
    Rectangle {
        x: 12px;
        y: root.up ? -self.height / 2 : (root.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        background: root.up ? root.ground : transparent;
        // Material's text field moves its label in 150 ms, fast out, slow in.
        animate y {
            duration: Motion.reduced ? 0ms : 150ms;
            easing: cubic-bezier(0.4, 0, 0.2, 1);
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            Caption {
                text: root.label;
                color: root.focused ? Ink.accent : Ink.dim;
                accessible-role: none;
            }
        }
    }
}

// A confirm dialog on its modal layer (make it the window's last child). The children are its message: Sub text in
// Ink.dim, wrapped, 10 px apart. The confirm button is the accent's, the bad ink's for a [danger]ous step, and faint
// while not [enabled]; Cancel, Esc and a click beside the dialog dismiss it.
export component Prompt inherits Modal {
    in property <string> title;
    in property <string> confirm;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback confirmed();
    callback dismissed();
    label: root.title;
    close => {
        root.dismissed();
    }
    Rectangle {
        min-width: 280px;
        max-width: 560px;
        border-radius: 28px;
        background: Ink.surface;
        VerticalLayout {
            padding: 24px;
            Title {
                text: root.title;
                wrap: word-wrap;
            }
            VerticalLayout {
                padding-top: 16px;
                padding-bottom: 24px;
                spacing: 10px;
                @children
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Secondary {
                    text: "Cancel";
                    color: Ink.dim;
                    clicked => {
                        root.dismissed();
                    }
                }
                Secondary {
                    text: root.confirm;
                    color: !root.enabled ? Ink.faint : root.danger ? Ink.bad : Ink.accent;
                    enabled: root.enabled;
                    clicked => {
                        root.confirmed();
                    }
                }
            }
        }
    }
}

// A caption in the page's gutters: a note under a group, or a page's quiet message.
export component CaptionRow inherits HorizontalLayout {
    in property <string> text;
    in property <color> color: Ink.dim;
    padding-left: 24px;
    padding-right: Metrics.gutter;
    padding-top: 8px;
    Caption {
        text: root.text;
        color: root.color;
        wrap: word-wrap;
    }
}
