+package local
+
+import (
+	"context"
+	"net"
+
+	"github.com/sagernet/sing-box/common/dialer"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	mDNS "github.com/miekg/dns"
+)
+
+// Unbraid: a name under a search or routing domain that one of the computer's networks gives, such as a work VPN's
+// own domain, belongs to that network: `preferred_by` sends it here, never to a resolver that doesn't know it.
+func (t *Transport) networkDomain(name string) bool {
+	systemConfig := t.configSource.Configuration()
+	if t.resolved != nil && systemConfig.SystemdResolved {
+		return t.resolved.NetworkDomain(name)
+	}
+	return underDomain(systemConfig.Search, name)
+}
+
+// Unbraid: the root ("~.") never counts: it says where every other name goes, not what a network owns.
+func underDomain(domains []string, name string) bool {
+	for _, domain := range domains {
+		if domain != "." && mDNS.IsSubDomain(domain, name) {
+			return true
+		}
+	}
+	return false
+}
+
+// Unbraid: dials each resolv.conf server through the interface the main routing table sends it to, when that isn't
+// the default route the engine binds everything to: a server only another network reaches, such as a work VPN's DNS
+// server routed through its link, is asked through that network, as systemd-resolved asks each link's own servers.
+type routedDialer struct {
+	N.Dialer
+	ctx context.Context
+}
+
+func (d *routedDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	return d.via(destination).DialContext(ctx, network, destination)
+}
+
+func (d *routedDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return d.via(destination).ListenPacket(ctx, destination)
+}
+
+func (d *routedDialer) Upstream() any {
+	return d.Dialer
+}
+
+func (d *routedDialer) via(destination M.Socksaddr) N.Dialer {
+	name := routeInterface(d.ctx, destination.Addr)
+	if name == "" {
+		return d.Dialer
+	}
+	bound, err := dialer.NewDefault(d.ctx, option.DialerOptions{
+		AbstractDialerOptions: option.AbstractDialerOptions{
+			BindInterface:      name,
+			UDPFragmentDefault: true,
+		},
+	})
+	if err != nil {
+		return d.Dialer
+	}
+	return bound
+}
diff --git a/dns/transport/local/local_network_linux.go b/dns/transport/local/local_network_linux.go
new file mode 100644
index 0000000..426c2f7
--- /dev/null
+++ b/dns/transport/local/local_network_linux.go
@@ -0,0 +1,69 @@
+//go:build linux
+
+package local
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"slices"
+
+	"github.com/sagernet/netlink"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/service"
+
+	"golang.org/x/sys/unix"
+)
+
+// Unbraid: the interface of the main routing table's most specific route to addr, or "" when that is the default
+// route, a route through no single link, or one through the engine's own TUN.
+func routeInterface(ctx context.Context, addr netip.Addr) string {
+	addr = addr.Unmap()
+	if !addr.IsValid() || addr.Zone() != "" {
+		return ""
+	}
+	family := netlink.FAMILY_V4
+	if addr.Is6() {
+		family = netlink.FAMILY_V6
+	}
+	routes, err := netlink.RouteListFiltered(family, &netlink.Route{Table: unix.RT_TABLE_MAIN}, netlink.RT_FILTER_TABLE)
+	if err != nil {
+		return ""
+	}
+	index := mostSpecific(routes, addr)
+	if index == 0 {
+		return ""
+	}
+	link, err := netlink.LinkByIndex(index)
+	if err != nil {
+		return ""
+	}
+	name := link.Attrs().Name
+	if networkManager := service.FromContext[adapter.NetworkManager](ctx); networkManager != nil {
+		if monitor := networkManager.InterfaceMonitor(); monitor != nil && slices.Contains(monitor.MyInterfaces(), name) {
+			return ""
+		}
+	}
+	return name
+}
+
+// Unbraid: the link index of the most specific route to addr (the lowest metric among equals), as the kernel picks;
+// 0 when that is a default route or has no single link (blackhole, multipath).
+func mostSpecific(routes []netlink.Route, addr netip.Addr) int {
+	var best *netlink.Route
+	bits := -1
+	for i := range routes {
+		route := &routes[i]
+		if route.Dst == nil || !route.Dst.Contains(net.IP(addr.AsSlice())) {
+			continue
+		}
+		ones, _ := route.Dst.Mask.Size()
+		if ones > bits || ones == bits && route.Priority < best.Priority {
+			best, bits = route, ones
+		}
+	}
+	if best == nil || bits == 0 {
+		return 0
+	}
+	return best.LinkIndex
+}
