+func (t *DBusResolvedResolver) NetworkDomain(name string) bool {
+	serverSet := t.savedServerSet.Load()
+	return serverSet != nil && slices.ContainsFunc(serverSet.scopes, func(it *resolvedScope) bool {
+		return underDomain(it.domains, name)
+	})
+}
