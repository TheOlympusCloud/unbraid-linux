+package local
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"os"
+	"os/exec"
+	"syscall"
+	"testing"
+
+	"github.com/sagernet/netlink"
+	"github.com/sagernet/sing-box/dns/transport/local/systemconfig"
+)
+
+// Unbraid: a network's own domains, and nothing above them; a top-level domain or the root claims nothing.
+func TestUnbraidNetworkDomain(t *testing.T) {
+	search := []string{"corp.example.", "com.", "."}
+	for name, want := range map[string]bool{
+		"intranet.corp.example.": true,
+		"Intranet.CORP.example.": true,
+		"corp.example.":          true,
+		"example.":               false,
+		"www.example.com.":       false,
+		"corp.example.org.":      false,
+	} {
+		if underDomain(search, name) != want {
+			t.Errorf("underDomain(%v, %q) = %v", search, name, !want)
+		}
+	}
+	if underDomain([]string{"."}, "www.example.com.") || underDomain([]string{"com."}, "www.example.com.") {
+		t.Error("the root or a whole top-level domain claims names (a Wi-Fi's `search com`)")
+	}
+
+	resolver := &DBusResolvedResolver{}
+	if resolver.NetworkDomain("intranet.corp.example.") {
+		t.Error("no link known yet")
+	}
+	resolver.savedServerSet.Store(&resolvedServerSet{scopes: []*resolvedScope{
+		{domains: []string{"."}, defaultRoute: true},
+		{domains: []string{"com."}},
+		{domains: []string{"corp.example."}},
+	}})
+	if !resolver.NetworkDomain("intranet.corp.example.") || resolver.NetworkDomain("www.example.com.") {
+		t.Error("only the link's own domain is a network's")
+	}
+}
+
+// Unbraid: systemd-resolved's links while it answers for the system (resolv.conf names it), else resolv.conf's own
+// search line, also when resolved can't be reached.
+func TestUnbraidNetworkDomainSource(t *testing.T) {
+	resolver := &DBusResolvedResolver{}
+	resolver.savedServerSet.Store(&resolvedServerSet{scopes: []*resolvedScope{{domains: []string{"vpn.example."}}}})
+	files := &systemconfig.Config{Search: []string{"corp.example."}}
+	viaResolved := &systemconfig.Config{Search: []string{"corp.example."}, SystemdResolved: true}
+	for _, c := range []struct {
+		resolved ResolvedResolver
+		config   *systemconfig.Config
+		name     string
+		want     bool
+		source   string
+	}{
+		{nil, files, "a.corp.example.", true, "resolv.conf"},
+		{resolver, files, "a.corp.example.", true, "resolv.conf that isn't resolved's"},
+		{resolver, files, "a.vpn.example.", false, "resolv.conf that isn't resolved's"},
+		{resolver, viaResolved, "a.vpn.example.", true, "resolved's links"},
+		{resolver, viaResolved, "a.corp.example.", false, "resolved's links"},
+		{nil, viaResolved, "a.corp.example.", true, "resolved out of reach"},
+	} {
+		if networkDomain(c.resolved, c.config, c.name) != c.want {
+			t.Errorf("%s: networkDomain(%s) = %v", c.source, c.name, !c.want)
+		}
+	}
+}
+
+// Unbraid: against a real routing table, in a user and network namespace of its own (skipped where none is allowed):
+// a work VPN's split route, the LAN, the default route, IPv6, a mapped and a zoned address.
+func TestUnbraidRouteInterface(t *testing.T) {
+	if os.Getenv("UNBRAID_NETNS") == "" {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestUnbraidRouteInterface$")
+		cmd.Env = append(os.Environ(), "UNBRAID_NETNS=1")
+		cmd.SysProcAttr = &syscall.SysProcAttr{
+			Cloneflags:  syscall.CLONE_NEWUSER | syscall.CLONE_NEWNET,
+			UidMappings: []syscall.SysProcIDMap{{ContainerID: 0, HostID: os.Getuid(), Size: 1}},
+			GidMappings: []syscall.SysProcIDMap{{ContainerID: 0, HostID: os.Getgid(), Size: 1}},
+		}
+		out, err := cmd.CombinedOutput()
+		var exit *exec.ExitError
+		if err != nil && !errors.As(err, &exit) {
+			t.Skip("no user and network namespace here: ", err)
+		}
+		if err != nil {
+			t.Fatalf("in the namespace:\n%s", out)
+		}
+		return
+	}
+	link := func(name string, addresses ...string) netlink.Link {
+		l := &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: name}}
+		if err := netlink.LinkAdd(l); err != nil {
+			t.Fatal(err)
+		}
+		for _, a := range addresses {
+			addr, err := netlink.ParseAddr(a)
+			if err == nil {
+				err = netlink.AddrAdd(l, addr)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := netlink.LinkSetUp(l); err != nil {
+			t.Fatal(err)
+		}
+		return l
+	}
+	route := func(r netlink.Route) {
+		if err := netlink.RouteAdd(&r); err != nil {
+			t.Fatal(r, err)
+		}
+	}
+	wlan := link("wlan0", "192.168.1.10/24")
+	ppp := link("ppp0", "10.212.134.200/32")
+	route(netlink.Route{LinkIndex: wlan.Attrs().Index, Gw: net.ParseIP("192.168.1.1")})
+	_, work, _ := net.ParseCIDR("10.0.0.0/8")
+	route(netlink.Route{LinkIndex: ppp.Attrs().Index, Dst: work})
+	_, work6, _ := net.ParseCIDR("2001:db8::/32")
+	route(netlink.Route{LinkIndex: ppp.Attrs().Index, Dst: work6})
+	for addr, want := range map[string]string{
+		"10.0.0.53":        "ppp0",
+		"::ffff:10.0.0.53": "ppp0",
+		"192.168.1.1":      "wlan0",
+		"93.184.216.34":    "",
+		"127.0.0.53":       "",
+		"2001:db8::53":     "ppp0",
+		"fe80::1%wlan0":    "",
+	} {
+		if got := routeInterface(context.Background(), netip.MustParseAddr(addr)); got != want {
+			t.Errorf("routeInterface(%s) = %q, want %q", addr, got, want)
+		}
+	}
+}
+
+// Unbraid: as the kernel picks: the longest prefix, then the lowest metric; nothing past a default route.
+func TestUnbraidMostSpecificRoute(t *testing.T) {
+	prefix := func(s string) *net.IPNet {
+		_, n, err := net.ParseCIDR(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	routes := []netlink.Route{
+		{LinkIndex: 2, Priority: 600},                                // default via the Wi-Fi
+		{LinkIndex: 3, Dst: prefix("10.0.0.0/8")},                    // a work VPN's split route
+		{LinkIndex: 4, Dst: prefix("10.0.0.0/24"), Priority: 100},    // the same, three times:
+		{LinkIndex: 5, Dst: prefix("10.0.0.0/24"), Priority: 50},     //   the lowest metric wins,
+		{LinkIndex: 8, Dst: prefix("10.0.0.0/24"), Priority: 70},     //   wherever it is listed
+		{LinkIndex: 2, Dst: prefix("192.168.1.0/24"), Priority: 600}, // the LAN
+		{Dst: prefix("10.9.0.0/16")},                                 // a blackhole: no link
+		{LinkIndex: 6, Dst: prefix("0.0.0.0/0"), Priority: 50},       // a default written out
+		{LinkIndex: 7, Dst: prefix("2001:db8::/32")},
+	}
+	for addr, want := range map[string]int{
+		"10.0.0.53":     5,
+		"10.1.2.3":      3,
+		"192.168.1.1":   2,
+		"93.184.216.34": 0,
+		"10.9.1.1":      0,
+		"2001:db8::53":  7,
+		"2001:db9::53":  0,
+	} {
+		if got := mostSpecific(routes, netip.MustParseAddr(addr)); got != want {
+			t.Errorf("mostSpecific(%s) = %d, want %d", addr, got, want)
+		}
+	}
+}
