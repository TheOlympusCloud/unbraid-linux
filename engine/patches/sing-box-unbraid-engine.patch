diff --git a/experimental/boxdd/unbraid_test.go b/experimental/boxdd/unbraid_test.go
new file mode 100644
index 0000000..431ad08
--- /dev/null
+++ b/experimental/boxdd/unbraid_test.go
@@ -0,0 +1,204 @@
+//go:build linux
+
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/peer"
+	"google.golang.org/grpc/status"
+)
+
+// Unbraid's checks on who may own the engine, and what a started service leaves on disk.
+
+// A daemon in its own working directory, with polkit answering polkit and the number of times it was asked.
+func unbraidDaemon(t *testing.T, polkit error) (*desktopService, *int) {
+	t.Helper()
+	previousDirectory, previousDefs, previousCheck := workingDirectory, loginDefsPath, checkPolicyKit
+	cwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		workingDirectory, loginDefsPath, checkPolicyKit = previousDirectory, previousDefs, previousCheck
+		_ = os.Chdir(cwd)
+	})
+	workingDirectory = t.TempDir()
+	loginDefsPath = filepath.Join(t.TempDir(), "login.defs")
+	err = os.WriteFile(loginDefsPath, []byte("#UID_MIN 500\nUID_MIN\t\t 1000\nUID_MAX\t\t60000\n"), 0o644)
+	if err != nil {
+		t.Fatal(err)
+	}
+	asked := 0
+	checkPolicyKit = func(ctx context.Context, identity peerIdentity, action string) error {
+		asked++
+		if action != policyKitClaimAction {
+			t.Errorf("polkit asked for %s", action)
+		}
+		return polkit
+	}
+	d, err := newDaemon()
+	if err != nil {
+		t.Fatal(err)
+	}
+	d.platform = nil // owners' sessions and system proxies belong to a desktop, not to the test
+	return &desktopService{daemon: d}, &asked
+}
+
+func asUser(uid string) context.Context {
+	return peer.NewContext(context.Background(), &peer.Peer{AuthInfo: &peerAuthInfo{identity: peerIdentity{UserID: uid, ProcessID: 4242, ProcessStartTime: 1}}})
+}
+
+func assertNoOwner(t *testing.T) {
+	t.Helper()
+	if owner, err := loadOwner(); !os.IsNotExist(err) {
+		t.Fatalf("an owner was saved: %q, %v", owner, err)
+	}
+}
+
+func TestUnbraidUnownedServiceNeedsPolkit(t *testing.T) {
+	s, asked := unbraidDaemon(t, status.Error(codes.PermissionDenied, "authorization was denied"))
+	_, err := s.StartService(asUser("1001"), &StartServiceRequest{ConfigContent: "{}"})
+	if status.Code(err) != codes.PermissionDenied {
+		t.Fatalf("start: %v", err)
+	}
+	_, err = s.ClaimService(asUser("1001"), nil)
+	if status.Code(err) != codes.PermissionDenied {
+		t.Fatalf("claim: %v", err)
+	}
+	_, err = s.TakeOverService(asUser("1001"), nil)
+	if status.Code(err) != codes.PermissionDenied {
+		t.Fatalf("take over: %v", err)
+	}
+	if *asked != 3 {
+		t.Fatalf("polkit was asked %d times", *asked)
+	}
+	assertNoOwner(t)
+}
+
+func TestUnbraidSystemAccountsCantClaim(t *testing.T) {
+	s, asked := unbraidDaemon(t, nil)
+	// www-data, the last system ID below UID_MIN, the first above UID_MAX, a systemd dynamic user, nobody.
+	for _, uid := range []string{"33", "999", "60001", "61184", "65534"} {
+		_, err := s.ClaimService(asUser(uid), nil)
+		if status.Code(err) != codes.PermissionDenied {
+			t.Fatalf("%s: %v", uid, err)
+		}
+	}
+	// Where UID_MAX reaches past it, nobody still never is a person.
+	err := os.WriteFile(loginDefsPath, []byte("UID_MIN 1000\nUID_MAX 70000\n"), 0o644)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = s.ClaimService(asUser("65534"), nil)
+	if status.Code(err) != codes.PermissionDenied {
+		t.Fatalf("nobody: %v", err)
+	}
+	if *asked != 0 {
+		t.Fatal("polkit was asked for a system account")
+	}
+	assertNoOwner(t)
+	// The last ID a person can have there is let through to polkit.
+	_, err = s.ClaimService(asUser("70000"), nil)
+	if err != nil || *asked != 1 {
+		t.Fatalf("70000: %v, polkit asked %d times", err, *asked)
+	}
+}
+
+func TestUnbraidOwnUserNeedsNoPolkit(t *testing.T) {
+	s, asked := unbraidDaemon(t, status.Error(codes.PermissionDenied, "authorization was denied"))
+	_, err := s.ClaimService(asUser(strconv.Itoa(os.Geteuid())), nil)
+	if err != nil || *asked != 0 {
+		t.Fatalf("claim: %v, polkit asked %d times", err, *asked)
+	}
+}
+
+func TestUnbraidClaimWithPolkitsYes(t *testing.T) {
+	s, asked := unbraidDaemon(t, nil)
+	_, err := s.ClaimService(asUser("1001"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner, err := loadOwner()
+	if err != nil || owner != "1001" {
+		t.Fatalf("owner %q: %v", owner, err)
+	}
+	// Owned now: the owner's own calls need no new yes, and another user's claim is turned away.
+	_, err = s.ClaimService(asUser("1001"), nil)
+	if err != nil || *asked != 1 {
+		t.Fatalf("again: %v, polkit asked %d times", err, *asked)
+	}
+	_, err = s.ClaimService(asUser("1002"), nil)
+	if status.Code(err) != codes.Aborted {
+		t.Fatalf("another user: %v", err)
+	}
+}
+
+// WireGuard's documentation keys.
+const (
+	testPrivateKey = "yAnz5TF+lXXJte14tji3zlMNq+hd2rYUIgJBgB3fBmk="
+	testPublicKey  = "xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg="
+)
+
+func TestUnbraidStartedServiceKeepsNoConfig(t *testing.T) {
+	s, _ := unbraidDaemon(t, nil)
+	config := `{"log":{"level":"error"},"endpoints":[{"type":"wireguard","tag":"wg","address":["10.66.0.2/32"],"private_key":"` + testPrivateKey +
+		`","peers":[{"address":"127.0.0.1","port":9,"public_key":"` + testPublicKey + `","allowed_ips":["0.0.0.0/0"]}]}],"outbounds":[{"type":"direct","tag":"direct"}]}`
+	_, err := s.StartService(asUser("1001"), &StartServiceRequest{ConfigContent: config})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.daemon.startedService.CloseService()
+	raw, err := base64.StdEncoding.DecodeString(testPrivateKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	files := 0
+	err = filepath.WalkDir(workingDirectory, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil || entry.IsDir() {
+			return err
+		}
+		files++
+		content, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		if bytes.Contains(content, []byte(testPrivateKey)) || bytes.Contains(content, raw) {
+			t.Errorf("%s holds the private key", path)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if files == 0 {
+		t.Fatal("the service saved nothing at all: the walk looked in the wrong place")
+	}
+}
+
+func TestUnbraidListenOnlyOnLoopback(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("as root --listen is always refused")
+	}
+	t.Setenv("INVOCATION_ID", "")
+	previous := listenAddress
+	t.Cleanup(func() { listenAddress = previous })
+	for address, allowed := range map[string]bool{
+		"127.0.0.1:7000": true, "[::1]:7000": true,
+		"0.0.0.0:7000": false, ":7000": false, "192.168.1.2:7000": false, "localhost:7000": false,
+	} {
+		listenAddress = address
+		handled, err := runService()
+		if (err == nil) != allowed || handled == allowed {
+			t.Errorf("%s: handled %v, %v", address, handled, err)
+		}
+	}
+}
