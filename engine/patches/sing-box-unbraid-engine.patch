+// Unbraid: owning an engine nobody owns routes the whole computer's traffic. It takes polkit's yes, which an active
+// local session gets without a prompt (as NetworkManager does), and never comes from a system account. The engine's own
+// user (root, for the system service) gains nothing by it and isn't asked.
+func authorizeClaim(ctx context.Context, identity peerIdentity) error {
+	if listenAddress != "" {
+		return nil
+	}
+	userID, err := strconv.ParseUint(identity.UserID, 10, 32)
+	if err != nil {
+		return status.Error(codes.Unauthenticated, "daemon peer has an invalid Linux user ID")
+	}
+	if userID == uint64(os.Geteuid()) {
+		return nil
+	}
+	uidMin, uidMax := loginUIDRange()
+	if userID < uidMin || userID > uidMax || userID == overflowUID {
+		return status.Error(codes.PermissionDenied, "system accounts can't use the service")
+	}
+	return checkPolicyKit(ctx, identity, policyKitClaimAction)
+}
+
+// Unbraid: the polkit check claims go through; tests replace it.
+var checkPolicyKit = checkPolicyKitAuthorization
+
+var loginDefsPath = "/etc/login.defs"
+
+// Unbraid: nobody, the kernel's overflow user ID: never a person, even where UID_MAX reaches it.
+const overflowUID = 65534
+
+// Unbraid: the user IDs login.defs gives people (1000 to 60000 unless set). Outside them are system accounts, such as
+// systemd's dynamic users (61184 to 65519).
+func loginUIDRange() (uidMin uint64, uidMax uint64) {
+	uidMin, uidMax = 1000, 60000
+	content, err := os.ReadFile(loginDefsPath)
+	if err != nil {
+		return
+	}
+	for _, line := range strings.Split(string(content), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) < 2 {
+			continue
+		}
+		value, parseErr := strconv.ParseUint(fields[1], 10, 32)
+		if parseErr != nil {
+			continue
+		}
+		switch fields[0] {
+		case "UID_MIN":
+			uidMin = value
+		case "UID_MAX":
+			uidMax = value
+		}
+	}
+	return
+}
+
