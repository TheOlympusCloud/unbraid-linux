 		return true, E.New("--listen is not allowed in service mode")
 	}
+	// Unbraid: --listen turns every check off, so never as root, and only on this computer.
+	if listenAddress != "" && (os.Geteuid() == 0 || !loopbackAddress(listenAddress)) {
