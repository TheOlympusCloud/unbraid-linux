# Packages the tree packaging/build.sh stages: the app and its engine, both native programs.
pkgname=unbraid
pkgver=@VERSION@
pkgrel=1
pkgdesc='Split tunneling VPN client: every app its own exit'
arch=('x86_64')
url='https://github.com/TheOlympusCloud/unbraid-linux'
license=('GPL-3.0-or-later')
# A font: the window's text has its own, but drawing it needs fontconfig to know at least one (a bare system has none).
depends=('glibc' 'gcc-libs' 'fontconfig' 'freetype2' 'ttf-font' 'libxkbcommon' 'libxkbcommon-x11' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'wayland')
optdepends=('polkit: to take over the connection another user started'
            'libsecret: to keep the store key in the desktop keyring'
            'libnotify: for desktop notifications'
            'gst-plugins-good: for the first-start introduction film')
install=unbraid.install
# Both programs are already stripped.
options=('!strip' '!debug')
source=("unbraid-$pkgver-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
    cp -a --no-preserve=ownership "$srcdir/usr" "$pkgdir/"
}
