#!/bin/sh
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = purge ]; then
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper purge unbraid-engine.service >/dev/null || true
    fi
    # The engine's per-user folders (the Tailscale node; never a configuration, which it doesn't keep).
    rm -rf /var/lib/unbraid-engine
fi
exit 0
