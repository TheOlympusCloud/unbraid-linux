<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The engine's own actions (unbraid-engine.service); everyday connecting needs none. -->
<policyconfig>
  <vendor>unbraid</vendor>
  <vendor_url>https://github.com/TheOlympusCloud/unbraid-linux</vendor_url>
  <action id="app.unbraid.engine.take-over-service">
    <description>Take over unbraid's connection from another user</description>
    <message>Authentication is required for unbraid to take over the connection another user on this computer started.</message>
    <icon_name>unbraid</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="app.unbraid.engine.set-insecure-mode">
    <description>Let unbraid's engine use privileges unrelated to networking</description>
    <message>Authentication is required to change unbraid's engine security settings.</message>
    <icon_name>unbraid</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
