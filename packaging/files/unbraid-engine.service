[Unit]
Description=unbraid engine: routes each app through its own VPN exit
Documentation=https://github.com/TheOlympusCloud/unbraid-linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The engine is sing-box's Linux daemon: it needs root for the TUN interface, routes and per-process lookups. The app
# talks to it over this socket; the daemon checks who connects, and polkit approves taking it over from another user.
ExecStart=/usr/lib/unbraid/unbraid-engine run --working-directory /var/lib/unbraid-engine --socket /run/unbraid-engine/engine.sock
RuntimeDirectory=unbraid-engine
RuntimeDirectoryMode=0755
StateDirectory=unbraid-engine
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
# The engine's sandbox: only the capabilities networking needs, the system read-only apart from its own folders, no
# home folders, and only the system calls and devices a network service uses.
# CAP_DAC_READ_SEARCH and CAP_SYS_PTRACE: naming each connection's program reads other users' /proc/<pid>/fd.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Not ProtectKernelTunables: the TUN and Tailscale may set /proc/sys/net.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A call outside the filter fails instead of killing the engine (and every tunnel with it).
SystemCallErrorNumber=EPERM
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
UMask=0077

[Install]
WantedBy=multi-user.target
